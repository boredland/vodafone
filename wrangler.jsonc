{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vodafone-stoerungen",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-13",
	"observability": { "enabled": true },
	"routes": [{ "pattern": "vodafone.jonas-strassel.de", "custom_domain": true }],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"]
	},
	"triggers": { "crons": ["*/5 * * * *"] },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vodafone-stoerungen",
			"migrations_dir": "migrations"
		}
	],
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": ["stoerungen@vodafone.jonas-strassel.de"]
		}
	],
	"ratelimits": [
		// Address lookups hit the Vodafone API; per client IP.
		{ "name": "LOOKUP_LIMITER", "namespace_id": "4711", "simple": { "limit": 60, "period": 60 } },
		// Subscription attempts may send confirmation mails; per client IP and per recipient.
		{ "name": "SUBSCRIBE_LIMITER", "namespace_id": "4712", "simple": { "limit": 5, "period": 60 } }
	],
	"vars": {
		"APP_URL": "https://vodafone.jonas-strassel.de",
		"EMAIL_FROM": "stoerungen@vodafone.jonas-strassel.de",
		// Public key embedded in the vodafone.de Störungsfinder bundle (net-assistant/js/main.js).
		"VODAFONE_API_KEY": "zLvy7xI46oZmfXjdzcEqClChiaS3pTcL"
	}
	// Secrets: VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY (see `npm run vapid`).
}
